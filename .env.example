# CareFlow Healthcare Management System - Environment Variables Example
# Copy this file or set these variables in your system / launch configuration

# Server Port (Default is 8082 to avoid collisions with Oracle TNSLSNR on 8080)
PORT=8082

# MySQL Database Configuration
DB_URL=jdbc:mysql://localhost:3306/hospital_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=YOUR_DATABASE_PASSWORD
